{
  "name": "dixi-health-report",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:mock": "MOCK_AI=1 npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
