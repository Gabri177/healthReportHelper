# 复制为 .env 后填写。不要把 .env 提交到仓库。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 开发时后端端口（前端 Vite 用 5173）
API_PORT=8787
# 生产环境（npm start）监听的端口，反向代理转发到这里
PORT=3000
# 监听地址：放在反向代理后面时填 127.0.0.1，只让代理访问；留空则监听所有网卡
HOST=
# 生成分享链接时使用的域名；留空则使用请求的 Host
PUBLIC_BASE_URL=
# 报告与原始文件的存放目录
DATA_DIR=./data
# 用于提取码 Cookie 签名，生产环境务必设置为随机长字符串
COOKIE_SECRET=
# 设为 1 时不调用 Claude，返回示例数据（用于调界面）
MOCK_AI=0
# 可选：PubMed（NCBI E-utilities）API Key，查文献更快
NCBI_API_KEY=
# 报告页上服务端渲染时间所用的时区（打开后会改为访客本地时间）
TZ_DISPLAY=Asia/Shanghai

# —— 共享资源与防滥用（详见 DEPLOY.md）——
# 全站同时进行的 Claude 调用数，超出的排队等待
CLAUDE_CONCURRENCY=4
# 每个 IP 每小时最多开始几次解读、上传几个文件；0 表示不限
RATE_SESSIONS_PER_HOUR=10
RATE_FILES_PER_HOUR=60
# 全站每天最多生成几份报告（按 UTC 日期）；0 表示不限
MAX_REPORTS_PER_DAY=0
# 信任哪个反向代理提供的访客 IP：默认 loopback（代理和本服务在同一台机器）；也可填跳数（如 1）或代理的 IP / 网段
TRUST_PROXY=loopback
